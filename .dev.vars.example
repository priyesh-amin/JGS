# Copy to .dev.vars for local Pages Functions development. Never commit real values.
APP_ORIGIN=http://localhost:8788
BOOTSTRAP_TOKEN=replace-with-private-bootstrap-token
OPERATIONAL_ADMIN_SETUP_TOKEN=replace-with-private-setup-token

# Source feeds. These examples are deliberately non-operational placeholders.
MASTER_FIXTURES_CSV_URL=https://example.invalid/fixtures.csv
MASTER_LEADERBOARDS_CSV_URL=https://example.invalid/leaderboards.csv
MEMBER_BALANCES_CSV_URL=https://example.invalid/member-balances.csv
EXPECTED_FIXTURE_IDS=season-opener-2026,may-monthly-2026,may-midweek-2026,june-monthly-2026,charity-day-2026,july-monthly-2026,july-midweek-2026,aug-monthly-2026,aug-midweek-2026,weekend-away-2026,sept-monthly-2026,season-finale-2026

# Approved workbook links returned only by the administrator operations API.
FIXTURES_WORKBOOK_URL=https://docs.google.com/spreadsheets/d/replace-with-approved-id/edit#gid=0
LEADERBOARDS_WORKBOOK_URL=https://docs.google.com/spreadsheets/d/replace-with-approved-id/edit#gid=0
MEMBER_BALANCES_WORKBOOK_URL=https://docs.google.com/spreadsheets/d/replace-with-approved-id/edit#gid=0
BOOKING_MANAGEMENT_WORKBOOK_URL=https://docs.google.com/spreadsheets/d/replace-with-approved-id/edit#gid=0
MEMBER_FINANCE_LINKS_WORKBOOK_URL=https://docs.google.com/spreadsheets/d/replace-with-approved-id/edit#gid=0

# Booking-output delivery. Dietary export deliberately has no enabling setting.
BOOKING_SYNC_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec
BOOKING_SYNC_TOKEN=replace-with-private-booking-sync-token
FIXTURE_SYNC_TOKEN=replace-with-private-fixture-sync-token

# Non-secret placeholder for the private recovery administrator identity.
RECOVERY_ADMIN_EMAIL=recovery-admin@example.invalid
