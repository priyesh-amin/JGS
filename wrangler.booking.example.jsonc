{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jgs-secure-booking-local",
  "compatibility_date": "2026-07-27",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jgs-secure-booking",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:8788",
    "MASTER_FIXTURES_CSV_URL": "https://docs.google.com/spreadsheets/d/1CT8BuIQOhymev6m7JTOcSfOGFJbSi_UjdNCH4Jkqbh0/export?format=csv&gid=1747129771",
    "DEFAULT_CANCELLATION_CUTOFF_DAYS": "7"
  }
}
